#!/usr/bin/env bash
[[ ! ${WARDEN_DIR} ]] && >&2 echo -e "\033[31mThis script is not intended to be run directly!\033[0m" && exit 1

# shellcheck disable=SC2034  # consumed by commands/usage.cmd after sourcing
WARDEN_USAGE=$(cat <<EOF
\033[33mUsage:\033[0m
  share <subcommand>

\033[33mSubcommands:\033[0m
  status            Show provider status and connected domains
  update            Regenerate the provider configuration and restart it

\033[33mCloudflare Tunnel (WARDEN_SHARE_PROVIDER=cloudflared):\033[0m
  login             Authenticate with Cloudflare (opens browser)
  create [name]     Create a new tunnel (default name: warden)
  delete            Delete the tunnel from Cloudflare
  logout            Remove all cloudflared credentials and config

\033[33mOptions:\033[0m
  -h, --help        Display this help menu

\033[33mDescription:\033[0m
  Exposes local projects to the public internet through a share provider.
  Projects opt-in by setting TRAEFIK_PUBLIC_DOMAIN in their .env file.

\033[33mSetup:\033[0m
  1. Set WARDEN_SHARE_PROVIDER=cloudflared in ~/.warden/.env
  2. warden share login       # Authenticate with the provider
  3. warden share create      # Create tunnel
  4. warden svc up            # Start global services (includes the share agent)
  5. Set TRAEFIK_PUBLIC_DOMAIN in project .env
  6. warden env up            # Start project (config auto-generated)
EOF
)
